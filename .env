# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and aqcuire TLS certificates
DOMAIN=localhost:5000
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:8080

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Shaderedder"
STACK_NAME=shaderedder

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:8080,https://localhost,https://localhost:8080"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
STORAGE=/uploads

# OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_CERTIFICATE=

# Emails
SMTP_HOST=mailhog
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=1025

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

#SENTRY_DSN=

# Redis
REDIS_PASSWORD=changethis
REDIS_HOST=redis
REDIS_PORT=6379

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@pgadmin.com
PGADMIN_DEFAULT_PASSWORD=changethis

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=services/backend
DOCKER_IMAGE_FRONTEND=services/frontend-vite
